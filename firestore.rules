rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000));
    }

    function isValidChatSession(data, expectedUserId) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == expectedUserId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.backendType is string && data.backendType.size() <= 32 &&
             data.modelName is string && data.modelName.size() <= 64;
    }

    function isValidChatMessage(data, expectedSessionId, expectedUserId) {
      return data.id is string && isValidId(data.id) &&
             data.sessionId is string && data.sessionId == expectedSessionId &&
             data.userId is string && data.userId == expectedUserId &&
             data.role is string && (data.role == 'user' || data.role == 'assistant' || data.role == 'system') &&
             data.content is string && data.content.size() <= 50000 &&
             (!('modelUsed' in data) || data.modelUsed == null || (data.modelUsed is string && data.modelUsed.size() <= 64)) &&
             (!('latencyMs' in data) || data.latencyMs == null || data.latencyMs is int);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'photoUrl', 'createdAt', 'lastLoginAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       (!('lastLoginAt' in incoming()) || (incoming().lastLoginAt is timestamp && incoming().lastLoginAt <= request.time)) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoUrl', 'lastLoginAt']);

      allow delete: if isOwner(userId);

      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().keys().hasAll(['id', 'userId', 'title', 'backendType', 'modelName', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'backendType', 'modelName', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                         isValidChatSession(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChatSession(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'backendType', 'modelName', 'updatedAt']);

        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);

          allow create: if isOwner(userId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll(['id', 'sessionId', 'userId', 'role', 'content', 'createdAt']) &&
                           incoming().keys().hasOnly(['id', 'sessionId', 'userId', 'role', 'content', 'modelUsed', 'latencyMs', 'createdAt']) &&
                           incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                           isValidChatMessage(incoming(), sessionId, userId);

          allow update: if isOwner(userId) &&
                           isValidId(messageId) &&
                           incoming().id == existing().id &&
                           incoming().sessionId == existing().sessionId &&
                           incoming().userId == existing().userId &&
                           incoming().createdAt == existing().createdAt &&
                           isValidChatMessage(incoming(), sessionId, userId) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['content', 'modelUsed', 'latencyMs']);

          allow delete: if isOwner(userId);
        }
      }
    }
  }
}
